							<row><label value="${labels.account.ct_tmp}" /><longbox id="fct_tmp"  mold="rounded"  value="@{usermain$composer.filterclientaccount.ct_tmp}" /></row>
							<row><label value="${labels.account.l_date}" /><datebox id="fl_date"  mold="rounded"  value="@{usermain$composer.filterclientaccount.l_date}" /></row>
							<row><label value="${labels.account.date_open}" /><datebox id="fdate_open"  mold="rounded"  value="@{usermain$composer.filterclientaccount.date_open}" /></row>
							<row><label value="${labels.account.date_close}" /><datebox id="fdate_close"  mold="rounded"  value="@{usermain$composer.filterclientaccount.date_close}" /></row>
