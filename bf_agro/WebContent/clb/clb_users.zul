							<listheader label="${labels.account.date_close}" />
							<listheader label="${labels.account.acc_group_id}" />
							--> 
							<listheader label="${labels.account.state}" width="150px" sort="auto(state)"/>
							<!--  
							<listheader label="${labels.account.kod_err}" />
							<listheader label="${labels.account.file_name}" />
							-->
		                </listhead>
					</listbox>
					<toolbar width="100%" align="center" height="35px" style="background: rgba(147,102,170, 0.2);">
				    	<div width="100%" align="center" height="35px">
							<hbox width="100%" widths="100%,200px" align="center" height="35px">
								<hbox width="100%">
									<toolbarbutton id="btn_clientaddacc" label="${labels.add}" image="/images/+.png" />
								</hbox>
							</hbox>
						</div>
					</toolbar>
				</groupbox>
			</div>
		</window>
	</panelchildren>
</panel>