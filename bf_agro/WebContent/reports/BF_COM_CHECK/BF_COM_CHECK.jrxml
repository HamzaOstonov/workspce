<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CHECK_2" pageWidth="595" pageHeight="850" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="135"/>
	<subDataset name="CHECK_DATA">
		<parameter name="INFO_SERVICE_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="INFO_PAYMENT_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="LOCALE" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{REPORT_LOCALE}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select t3.A_VALUE--,t3.printable
from
(
select t2.* from
(
select rownum as rwnum,t1.* from
(
Select
       (CASE
            WHEN LOCALE.LOCALE_SET = UPPER('RU_RU') and
                 IL.NAME_RU IS NOT NULL THEN
             IL.NAME_RU
            WHEN LOCALE.LOCALE_SET = UPPER('UZ_UZ') and
                 IL.NAME_UZ IS NOT NULL THEN
             IL.NAME_UZ
            WHEN LOCALE.LOCALE_SET = UPPER('EN_US') and
                 IL.NAME_EN IS NOT NULL THEN
             IL.NAME_EN
            ELSE
             ADDINF.A_KEY
       END)||': '||addinf.a_VALUE AS A_VALUE,
       il.printable

From   BF_COM_JPAY_ADDINFO ADDINF,
       BF_COM_JPAY_ADDINFO_LABELS  IL,
 (Select UPPER('RU_RU') AS LOCALE_SET From DUAL) LOCALE
       Where  ADDINF.ID = $P{INFO_PAYMENT_ID}
       and  IL.SERVICE_ID =  $P{INFO_SERVICE_ID}
       and ADDINF.A_VALUE IS NOT NULL
       and DECODE(IL.KEY_ID, NULL, 1, IL.PRINTABLE) = 1
       and il.key_id = addinf.a_key
ORDER  BY IL.ID_ORDER
)t1)t2 where t2.rwnum>=1 and t2.rwnum <=13 )t3  full join (select '-XXX-' as A_VALUE from dual connect by level <=13)t4
on t3.A_VALUE =  t4.A_VALUE  where rownum <=13]]>
		</queryString>
		<field name="A_VALUE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="CHECK_DATA_2">
		<parameter name="INFO_SERVICE_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="INFO_PAYMENT_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="LOCALE" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{REPORT_LOCALE}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select t3.A_VALUE,t3.printable
from
(
select t2.* from
(
select rownum as rwnum,t1.* from
(
Select
       (CASE
            WHEN LOCALE.LOCALE_SET = UPPER('RU_RU') and
                 IL.NAME_RU IS NOT NULL THEN
             IL.NAME_RU
            WHEN LOCALE.LOCALE_SET = UPPER('UZ_UZ') and
                 IL.NAME_UZ IS NOT NULL THEN
             IL.NAME_UZ
            WHEN LOCALE.LOCALE_SET = UPPER('EN_US') and
                 IL.NAME_EN IS NOT NULL THEN
             IL.NAME_EN
            ELSE
             ADDINF.A_KEY
       END)||': '||addinf.a_VALUE AS A_VALUE,
       il.printable

From   BF_COM_JPAY_ADDINFO ADDINF,
       BF_COM_JPAY_ADDINFO_LABELS  IL,
 (Select UPPER('RU_RU') AS LOCALE_SET From DUAL) LOCALE
       Where  ADDINF.ID = $P{INFO_PAYMENT_ID}
       and  IL.SERVICE_ID = $P{INFO_SERVICE_ID}
       and ADDINF.A_VALUE IS NOT NULL
       and DECODE(IL.KEY_ID, NULL, 1, IL.PRINTABLE) = 1
       and il.key_id = addinf.a_key
ORDER  BY IL.ID_ORDER
)t1)t2 where t2.rwnum>=14 and t2.rwnum <=26 )t3  full join (select '-XXX-' as A_VALUE from dual connect by level <=13)t4
on t3.A_VALUE =  t4.A_VALUE  where rownum <=13]]>
		</queryString>
		<field name="A_VALUE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="CHECK_DATA_3">
		<parameter name="INFO_SERVICE_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="INFO_PAYMENT_ID" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="LOCALE" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{REPORT_LOCALE}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select t3.A_VALUE
from
(
select t2.* from
(
select rownum as rwnum,t1.* from
(
Select
       (CASE
            WHEN LOCALE.LOCALE_SET = UPPER('RU_RU') and
                 IL.NAME_RU IS NOT NULL THEN
             IL.NAME_RU
            WHEN LOCALE.LOCALE_SET = UPPER('UZ_UZ') and
                 IL.NAME_UZ IS NOT NULL THEN
             IL.NAME_UZ
            WHEN LOCALE.LOCALE_SET = UPPER('EN_US') and
                 IL.NAME_EN IS NOT NULL THEN
             IL.NAME_EN
            ELSE
             ADDINF.A_KEY
       END)||': '||addinf.a_VALUE AS A_VALUE

From   BF_COM_JPAY_ADDINFO ADDINF
LEFT   OUTER JOIN (Select *
                   From   BF_COM_JPAY_ADDINFO_LABELS L
                   Where  L.SERVICE_ID = $P{INFO_SERVICE_ID} and l.printable = 1) IL
ON     IL.KEY_ID = ADDINF.A_KEY,
 (Select UPPER('RU_RU') AS LOCALE_SET From DUAL) LOCALE
Where  ADDINF.ID = $P{INFO_PAYMENT_ID}
       and ADDINF.A_VALUE IS NOT NULL
       and DECODE(IL.KEY_ID, NULL, 1, IL.PRINTABLE) = 1
ORDER  BY IL.ID_ORDER
)t1)t2 where t2.rwnum>=35 and t2.rwnum <=51)t3  full join (select '-XXX-' as A_VALUE from dual connect by level <=17)t4
on t3.A_VALUE =  t4.A_VALUE  where rownum <=17]]>
		</queryString>
		<field name="A_VALUE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1"/>
	<parameter name="P_BRANCH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMP_ID" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_JPAYMENT_ID" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DUBLICATE" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select (case when rownum = 1 or rownum = 3 then 'ХАБАРНОМА' else 'ПАТТА' end ) as CHECK_TYPE,data.* from
(
Select
       JP.ID AS CHECK_NUM,
       to_char(jp.date_complete,'dd.MM.yyyy')as date_complete,
       to_char(jp.date_complete,'HH24:mi:ss')as time_complete,
       bf_com_GET_CHECK_KASSA_NAME($P{P_BRANCH} ,$P{P_EMP_ID} ,jp.operation_id ) as kassa,
       info.GetUserFullName($P{P_EMP_ID},$P{P_BRANCH}) as kassir,
      -- ('касса неопределена') as kassa,
      -- ('кассир неопределен') as kassir,
      to_char((JP.AMOUNT/100),'99999999999.99')  as AMOUNT,
       cus.name as cus_name,
       SL.NAME as service_name,
       sl.id as service_id,
       decode($P{P_DUBLICATE},1,'     (ДУБЛИКАТ)',' ')as dublicate,
       (select bf.get_sum_str_1(JP.AMOUNT/100,'сум','тийин') from dual) as str_amount,
       --(select bank_name from s_mfo smf where smf.bank_id = addinfo.payee_branch ) as payee_branch_name,
       (select A_VALUE from BF_COM_JPAY_ADDINFO where id=$P{P_JPAYMENT_ID} and a_key = 'sysinfo_bid') as NUM_MUNIS,
       (select A_VALUE from BF_COM_JPAY_ADDINFO where id=$P{P_JPAYMENT_ID} and a_key = 'confirm_message') as REZULT_MUNIS,
       $P{P_BRANCH} as MFO_PLAT

      -- addinfo.*
From   BF_COM_JPAYMENTS     JP,
       BF_COM_SERVICES_LIST SL,
       BF_COM_CUSTOMERS cus
Where  jp.id = $P{P_JPAYMENT_ID}
       and SL.ID = JP.SERVICES_LIST_ID
       and cus.id = sl.customerj_id
      -- and addinfo.srvid = JP.SERVICES_LIST_ID
) data
connect by level <= 1]]>
	</queryString>
	<field name="CHECK_TYPE" class="java.lang.String"/>
	<field name="CHECK_NUM" class="java.math.BigDecimal"/>
	<field name="DATE_COMPLETE" class="java.lang.String"/>
	<field name="TIME_COMPLETE" class="java.lang.String"/>
	<field name="KASSA" class="java.lang.String"/>
