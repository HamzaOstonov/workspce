<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="arch_inquiry" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Id_Payment" class="java.lang.Long">
		<defaultValueExpression><![CDATA[8251]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select p.id as payment_id,
       ----
       g.id as document_id,
       g.emp_id, u.full_name,
       g.summa,
       g.doc_num,
       cl.bank_name as cl_bank_name, -- наименование банка отправителя
       g.bank_cl, -- МФО банка отправителя
       g.acc_cl, -- Р/с отправителя
       co.bank_name as co_bank_name, -- наименование банка получателя
       g.bank_co, -- МФО банка получателя
       g.acc_co, -- Р/с получателя
       ----
       s.id as service_id, s.name as service_name, -- Услуга
       ct.name as cust_name, -- получатель
       p.branch_id, p.subbranch_id, p.subdivision, -- Банк плательщика, филиал
       p.user_id, -- Кассир
       p.p_name, p.p_number, -- Имя плательщика, абонентский номер плательщика
       p.client_address, -- Адрес плательщика
       p.date_complete, -- Дата платежа.
       p.amount, -- сумма платежа
       p.fee_amount, -- комиссия
       p.penalty_amount -- пеня
  from bf_com_jpayments     p,
       bf_com_services_list s,
       bf_com_customers     ct,
       ----
       general g, s_mfo cl, s_mfo co, users u
 where p.services_list_id = s.id
       and ct.id = s.customerj_id
       ----
       and p.g_docid = g.id
       and p.g_branch = g.branch
       and g.bank_cl = cl.bank_id
       and g.bank_co = co.bank_id
       and g.emp_id = u.id
       and p.id = $P{Id_Payment}]]>
	</queryString>
