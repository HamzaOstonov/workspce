           transform: translate(-50%, -50%); background-color: rgba(255, 255, 255, 0.9); 
           box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);"
						closable="true" height="auto" border="normal">
						<label value="detailsWindow"
							style="font-weight:bold;" />
						<vbox width="100%" pack="center">
							<grid width="100%">
								<columns>
									<column width="60%" align="center"
										valign="middle" />
									<column width="40%" align="center"
										valign="middle" />
								</columns>

								<rows>
									<row>
										<label value="BRANCH" />
										<textbox id="branch"
											width="300px" />
									</row>
									<row>
										<label value="USER_ID" />
										<textbox id="user_id"
											width="300px" />
									</row>
									<row>
										<label value="USER_NAME" />
										<textbox id="user_name"
											width="300px" />
									</row>
									<row>
										<label value="USER_MAC" />
										<textbox id="user_mac"
											width="300px" />
									</row>
									<row>
										<label value="USER_IP" />
										<textbox id="user_ip"
											width="300px" />
									</row>
									<row>
										<label value="TYPE_LOG" />
										<textbox id="type_log"
											width="300px" />
									</row>
									<row>
										<label value="LOG_TEXT" />
										<textbox id="log_text"
											width="300px" />
									</row>
									<row>
										<label value="V_DATE" />
										<datebox id="v_date"
											width="300px" />
									</row>
									<row>
										<label value="DATE_TIME" />
										<datebox id="date_time"
											width="300px" />
									</row>
									<row>
										<label value="GROUP_ID" />
										<textbox id="group_id"
											width="300px" />
									</row>
								</rows>
							</grid>

							<toolbar id="searchToolbar2"
								visible="true">
								<hbox pack="center" width="100%">
									<separator spacing="20px" />
									<toolbarbutton id="btn_exit2"
										label="Выход" image="/images/search.png" />
								</hbox>
							</toolbar>
						</vbox>
					</window>
				</vlayout>
			</tabpanel>
			
