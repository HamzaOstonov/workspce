<?component name="rcombobox" extends="combobox" class="com.is.utils.RefCBox"?>
<?component name="refcbox" class="com.is.utils.RefCBox"?>
<window id="useractionlogmain" width="100%" height="100%"
	border="normal" apply="com.is.useractionlog.UserActionLogViewCtrl">
	<tabbox id="mainTabbox">
		<tabs>
			<tab label="bf_user_actions_log" id="tab1" />
			<tab label="general_log" id="tab2" />
			<tab label="log_protocol" id="tab3" />
			<tab label="report_history" id="tab4" />
		</tabs>
		<tabpanels>
			
			<tabpanel><!-- bf_user_actions_log -->
				<vlayout id="grd1" hflex="1">
					<grid id="mainGrid1" visible="true" width="100%">
						<columns>
							<column width="40%" />
							<column width="60%" />
						</columns>
						<rows>
							<row>
								<label value="USERNAME" />
								<textbox id="txtusername1" hflex="1"
									value="" />
							</row>
							<row>
								<label value="DATE" />
								<datebox id="txtdate1" hflex="1" />
							</row>
						</rows>
					</grid>
					<toolbar id="searchToolbar1" visible="true">
						<toolbarbutton id="tbtn_search1" label="Поиск"
							image="/images/search.png" />
					</toolbar>
					<paging id="userActionsLogPaging1" pageSize="10" />
					<listbox id="dataDetailsGrid1" rows="20"
						style="border:normal;height:700px;" width="100%">
						<listhead sizable="true">
							<listheader label="ID" />
							<listheader label="BRANCH" />
							<listheader label="USER_ID" />
							<listheader label="USER_NAME" />
							<listheader label="USER_IP" />
							<listheader label="ACTION_DATE" />
							<listheader label="ACT_TYPE" />
							<listheader label="ENTITY_TYPE" />
							<listheader label="ENTITY_ID" />
						</listhead>
					</listbox>
				</vlayout>
				<vlayout>
					<window id="detailsWindow1" mode="overlapped"
						visible="false" width="80%"
						style="position: absolute; top: 50%; left: 50%; 
           transform: translate(-50%, -50%); background-color: rgba(255, 255, 255, 0.9); 
           box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);"
						closable="true" height="auto" border="normal">
						<label value="detailsWindow"
							style="font-weight:bold;" />
						<vbox width="100%" pack="center">
							<grid width="100%">
								<columns>
									<column width="60%" align="center"
										valign="middle" /><!-- Changed align to center -->
									<column width="40%" align="center"
										valign="middle" /><!-- Changed align to center -->
								</columns>

								<rows>
									<row>
										<label value="ID" />
										<textbox id="id" width="300px" />
									</row>
									<row>
										<label value="BRANCH" />
										<textbox id="branch"
											width="300px" />
									</row>
									<row>
										<label value="USER_ID" />
										<textbox id="user_id"
											width="300px" />
									</row>
									<row>
										<label value="USER_NAME" />
										<textbox id="user_name"
											width="300px" />
									</row>
									<row>
										<label value="IP ADRESS" />
										<textbox id="ip_address"
											width="300px" />
									</row>
									<row>
										<label value="ACTION_DATE" />
										<datebox id="action_date"
											width="300px" />
									</row>
									<row>
										<label value="ACT_TYPE" />
										<textbox id="act_type"
											width="300px" />
									</row>
									<row>
										<label value="ENTITY_TYPE" />
										<textbox id="entity_type"
											width="300px" />
									</row>
									<row>
										<label value="ENTITY_ID" />
										<textbox id="entity_id"
											width="300px" hflex="1" multiline="true" rows="1" />
									</row>
								</rows>
							</grid>

							<toolbar id="searchToolbar"
								visible="true">
								<hbox pack="center" width="100%">
									<separator spacing="20px" />
									<toolbarbutton id="btn_exit1"
										label="Выход" image="/images/search.png" />
								</hbox>
							</toolbar>
						</vbox>
					</window>
				</vlayout>
			</tabpanel>

			<tabpanel><!-- general_log -->
				<vlayout id="grd2" hflex="1">
					<grid id="mainGrid2" visible="true" width="100%">
