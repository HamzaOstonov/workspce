					<row><label value="${labels.pc.user_card.client_id}" /><longbox id="client_id"  mold="rounded"  value="@{user_cardmain$composer.current.client_id}" /></row>
					<row><label value="${labels.pc.user_card.card_number}" /><textbox id="card_number"  mold="rounded"  value="@{user_cardmain$composer.current.card_number}" /></row>
					<row><label value="${labels.pc.user_card.access_id}" /><longbox id="access_id"  mold="rounded"  value="@{user_cardmain$composer.current.access_id}" /></row>
					<row><label value="${labels.pc.user_card.state}" /><longbox id="state"  mold="rounded"  value="@{user_cardmain$composer.current.state}" /></row>
                </rows>
          	</grid>
          	<grid id="addgrd" visible="false">
            	<columns>
