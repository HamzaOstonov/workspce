					<!-- <listheader label="${labels.ni_req.end_date}" width="200px" /> 
						<listheader label="${labels.ni_req.dbinn}" width="200px" /> <listheader label="${labels.ni_req.dbbranch}" 
						width="200px" /> <listheader label="${labels.ni_req.dbaddress}" width="200px" 
						/> <listheader label="${labels.ni_req.v_date}" width="200px" /> <listheader 
						label="${labels.ni_req.resolve_org}" width="200px" /> <listheader label="${labels.ni_req.is_letter}" 
						width="200px" /> <listheader label="${labels.ni_req.sign_client}" width="200px" 
						/> <listheader label="${labels.ni_req.rezkl}" width="200px" /> <listheader 
						label="${labels.ni_req.client_type}" width="200px" /> <listheader label="${labels.ni_req.inn_passport}" 
						width="200px" /> <listheader label="${labels.ni_req.fac_resident}" width="200px" 
						/> <listheader label="${labels.ni_req.fac_j_code_organ_direct}" width="200px" 
						/> <listheader label="${labels.ni_req.fac_class_id}" width="200px" /> <listheader 
						label="${labels.ni_req.inn_org}" width="200px" /> <listheader label="${labels.ni_req.name_org}" 
						width="200px" /> <listheader label="${labels.ni_req.nwp}" width="200px" /> 
						<listheader label="${labels.ni_req.qw}" width="200px" /> <listheader label="${labels.ni_req.etype}" 
						width="200px" /> <listheader label="${labels.ni_req.type_zm}" width="200px" 
