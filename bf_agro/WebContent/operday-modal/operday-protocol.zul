<?page title="Operation Day Controller" contentType="text/html;charset=UTF-8"?>
<zk>
    <window apply="com.is.operday.composer.main.branches.modal.ProtocolWindow">
        <label>Период с:</label>
        <datebox id="dateProtocolStart"/>
        <label>по:</label>
        <datebox id="dateProtocolEnd"/>
        <button id="btnShowProtocol" label="Показать"/>
        <grid>
            <columns>
                <column align="center" width="10%">Опердень</column>
                <column align="center" width="20%">Дата</column>
                <column align="center" width="70%">Сообщение</column>
            </columns>
            <rows id="protocolData"/>
        </grid>
    </window>
</zk>