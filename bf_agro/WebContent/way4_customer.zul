<?xml version="1.0" encoding="UTF-8"?>
<?component name="rcombobox" extends="combobox" class="com.is.openwayutils.utils.RefCBox"?>
<window id="customermain" width="100%"
	apply="com.is.openwayj.customer.AddCstViewCtrl">

	<menupopup id="editPopup">
		<menuitem id="pop_open_cl" label="${labels.openway.opencl}" />
	</menupopup>

	<hlayout sclass="z-valign-top" style="overflow:auto;">

		<div id="leftToolbar" visible="true" width="240px">
			<grid id="tfgrd">
				<columns>
					<column width="30%" />
					<column width="70%" />
				</columns>
				<rows>
					<row>
						<label value="${labels.openway.client_b}" />
						<textbox id="txbId_client"
							value="@{customermain$composer.filter.id_client}" forward="onOK=onOkToFilter" />
					</row>
					<row>
						<label value="${labels.openway.pinfl}" />
						<textbox id="txbPinfl"
							value="@{customermain$composer.filter.p_pinfl}" forward="onOK=onOkToFilter" />
					</row>
					<row>
						<label value="${labels.openway.f_names}" />
						<textbox id="txtName"
							value="@{customermain$composer.filter.name}" forward="onOK=onOkToFilter" />
					</row>

					<row>
						<label value="${labels.openway.b_date}" />
						<datebox id="dbxB_date"
							value="@{customermain$composer.filter.p_birthday}" forward="onOK=onOkToFilter" />
					</row>

					<row>
						<label value="${labels.openway.card}" />
						<textbox id="txtCard"
							value="@{customermain$composer.filter.p_code_bank}" forward="onOK=onOkToFilter" />
					</row>

					<row>
						<label value="Серия и номер паспорта" />
						<textbox id="txtPassportSerial"
							value="@{customermain$composer.filter.p_passport_serial}" forward="onOK=onOkToFilter" />
					</row>

				</rows>
			</grid>
			<toolbar visible="true" orient="vertical">
				<toolbarbutton id="tbtn_search"
					label="${labels.openway.search}" image="/images/search.png" />
				<toolbarbutton id="btn_utv"
					label="${labels.openway.comm}" visible="false"
					image="/images/stop.png" />
				<toolbarbutton id="btn_add_everywhere"
					label="${labels.openway.openclall}"
					image="/tnbtn_addimages/uses.png" />
				<toolbarbutton id="btn_add_way"
					label="Открыть первую карту"
					image="/images/+.png" />
				<toolbarbutton id="btn_add_acc"
					label="Открыть вторую карту с новым счетом"
					image="/images/+.png" />
				<toolbarbutton id="btn_add_card"
					label="Открыть дополнительную карты на имеющийся счет"
					image="/images/+.png" />
				<toolbarbutton id="tbtn_card_oprations"
					label="${labels.openway.AddCstViewCtrl.cardoper}"
					image="/images/credit_card2.png" />
				<toolbarbutton id="btn_VIP"
					label="OpenWay Выписка"
					image="/images/credit_card2.png" />

			</toolbar>
		</div>

		<vlayout id="tgrd" hflex="1">

			<listbox
				style="border:normal; background-color:white;height:240px;"
				id="branch_customers" rows="10" multiple="true"
				selectedItem="@{customermain$composer.current}">
				<auxhead>
					<auxheader colspan="2" />
					<auxheader label="Данные Openway" colspan="5"
						align="middle" />
					<auxheader label="${labels.openway.brdata}"
						colspan="6" align="middle" />
				</auxhead>
				<listhead sizable="false">

					<listheader width="10px" />
					<listheader width="35px" />

					<listheader label="ПИНФЛ" width="9%" />
					<listheader label="ФИО" width="15%" />
					<listheader label="Дата рождения" width="9%" />
					<listheader label="Паспорт" width="7%" />
					<listheader width="35px" />

					<listheader label="${labels.openway.client_b}" width="8%" />
					<listheader label="${labels.openway.f_names}" width="15%" />
					<listheader label="${labels.openway.b_date}" width="9%" />
					<listheader label="Пинфл/Инн" width="9%" />					
					<listheader label="Паспорт" width="7%" />
					<listheader width="35px" />

				</listhead>

			</listbox>

			<paging id="bankdataPaging" />

			<hlayout style="overflow:auto;">
				<listbox id="accGrid" rows="8" 
					hflex="2" selectedItem="@{customermain$composer.curr_acc}">					
					<listhead sizable="true">
						
						<listheader
							label="ContractNumberIBS" width="190px"
							sort="auto(ab_expirity)" />
						<listheader label="Contract number WAY"
							width="120px" sort="auto(card_acct)" />
						<listheader label="Tranz acct"
							width="180px" sort="auto(tranz_acct)" />
						<listheader label="Product code"
							width="120px" sort="auto(status1)" />
						<listheader label="Phone"
							width="100px" />
						<listheader id="lh_sms_acc" label="SMS status"
							width="170px" />
                        <listheader width="35px" />
					</listhead>

				</listbox>

				<listbox id="cardGrid" rows="8"
					hflex="3" selectedItem="@{customermain$composer.curr_card}">
					<listhead sizable="true">
                      <!-- <ContractNumber>430142______2890</ContractNumber> .ContractNumber -->
						<listheader label="ContractNumber(Way)"
							width="130px" />
						<listheader label="CardExpiry" width="70px" />
			    	  <!-- bf_openway_contract_card.sub_product_code VISA_CLASSIC_USD .productcode1 -->
						<listheader label="Product Code(IBS)" width="150px"  />
					  <!-- bf_openway_contract_card.cbs_number 430142______2890  .cbsNumber -->
						<listheader
							label="ContractNumber(IBS)" width="180px" />
					  <!-- bf_openway_contract_card.rbs_number 9058-P-547326-0000003 .rbsNumberIbs -->
						<listheader label="RbsNumber(IBS)"
							width="180px"  />
						<listheader label="Balance"
							width="55px" />
						<listheader label="${labels.accinfo.status1}"
							width="150px"  />
						<listheader label="Status2 "
							width="70px" />
						<listheader label="Phone"
							width="95px" />
						<listheader id="lh_sms_card" label="SMS status"
							width="170px" />
						<!--<listheader label="Action"
							width="70px" /> -->
							
					</listhead>
				</listbox>

			</hlayout>
		</vlayout>


	</hlayout>

	<window id="add_everywhere" mode="modal" width="70%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Открытие клиента в НПС HUMO" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="100%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row>
							<label value="Тип клиента(категория) *" />
							<rcombobox id="ao_category_client" width="90%"
								selecteditem="@{customermain$composer.current.o_client_type}" />
						</row>
						<row>
							<label value="Код клиента" />
							<textbox id="aid_client" width="90%"
								value="@{customermain$composer.current.id_client}"
								readonly="true" />
						</row>
						<row>
							<label value="Тип документа *" />
							<rcombobox id="ap_type_document" width="90%"
								selecteditem="@{customermain$composer.current.p_type_document}" />
						</row>
						<row>
							<label value="Серия паспорта(Д.У.Л.) *" />
							<textbox id="ap_passport_serial" width="90%"
								value="@{customermain$composer.current.p_passport_serial}" />
						</row>
						<row>
							<label value="Номер паспорта(Д.У.Л.) *" />
							<textbox id="ap_passport_number" width="90%"
								value="@{customermain$composer.current.p_passport_number}" />
						</row>
						<row>
							<label
								value="Дата регистрации паспорта(Д.У.Л.) *" />
							<datebox id="ap_passport_date_registration" width="90%"
								value="@{customermain$composer.current.p_passport_date_registration}" />
						</row>
						<row>
							<label value="Действителен до " />
							<datebox id="ap_passport_date_expiration" width="90%"
								value="@{customermain$composer.current.p_passport_date_expiration}" />
						</row>
						<row>
							<label
								value="Место регистрации паспорта(Д.У.Л.) *" />
							<textbox id="ap_passport_place_registration" width="90%"
								value="@{customermain$composer.current.p_passport_place_registration}" />
						</row>
						<row>
							<label value="ПИНФЛ *" />
							<textbox id="ap_pinfl" width="90%"
								value="@{customermain$composer.current.p_pinfl}" />
						</row>
						<row>
							<label value="Фамилия *" />
							<textbox id="ap_family" width="90%"
								value="@{customermain$composer.current.p_family}" />
						</row>
						<row>
							<label value="Имя *" />
							<textbox id="ap_first_name" width="90%"
								value="@{customermain$composer.current.p_first_name}" />
						</row>
						<row>
							<label value="Отчество " />
							<textbox id="ap_patronymic" width="90%"
								value="@{customermain$composer.current.p_patronymic}" />
						</row>
						<row>
							<label value="ИНН" />
							<textbox id="ap_number_tax_registration" width="90%"
								value="@{customermain$composer.current.p_number_tax_registration}" />
						</row>
						<row>
							<label
								value="Кодовое слово для идентификации клиента *" />
							<textbox id="ao_security_name" width="90%"
								value="@{customermain$composer.current.o_security_name}" />
						</row>
						<row>
							<label value="Страна *" />
							<rcombobox id="acode_country" width="90%"
								selecteditem="@{customermain$composer.current.code_country}" />
						</row>
						<row>
							<label value="Гражданство *" />
							<rcombobox id="ap_code_citizenship" width="90%"
								selecteditem="@{customermain$composer.current.p_code_citizenship}" />
						</row>
					</rows>
				</grid>
				<grid id="addgrdr" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row>
							<label value="Дата рождения *" />
							<datebox id="ap_birthday" width="90%"
								value="@{customermain$composer.current.p_birthday}" />
						</row>
						<row>
							<label value="Место рождения *" />
							<textbox id="ap_birth_place" width="90%"
								value="@{customermain$composer.current.p_birth_place}" />
						</row>
						<row>
							<label value="Пол" />
							<rcombobox id="ap_code_gender" width="90%"
								selecteditem="@{customermain$composer.current.p_code_gender}" />
						</row>
						<row>
							<label value="Номер телефона домашный" />
							<textbox id="ap_phone_home" width="90%"
								value="@{customermain$composer.current.p_phone_home}" />
						</row>
						<row>
							<label value="Номер телефона мобильный *" />
							<textbox id="ap_phone_mobile" width="90%"
								value="@{customermain$composer.current.p_phone_mobile}" />
						</row>
						<row>
							<label value="email *" />
							<textbox id="ap_email_address" width="90%"
								value="@{customermain$composer.current.p_email_address}" />
						</row>
						<row>
							<label value="Код области адреса *" />
							<rcombobox id="ap_code_adr_region" width="90%"
								selecteditem="@{customermain$composer.current.p_code_adr_region}" />
						</row>
						<row>
							<label value="Код района адреса *" />
							<rcombobox id="ap_code_adr_distr" width="90%"
								selecteditem="@{customermain$composer.current.p_code_adr_distr}" />
						</row>
						<row>
							<label value="Город *" />
							<textbox id="ao_city" width="90%"
								value="@{customermain$composer.current.o_city}" />
						</row>
						<row>
							<label value="Почтовый индекс *" />
							<textbox id="ap_zip_code" width="90%"
								value="@{customermain$composer.current.p_zip_code}" />
						</row>
						<row>
							<label value="Адрес *" />
							<textbox id="ap_post_address" width="90%"
								value="@{customermain$composer.current.p_post_address}" />
						</row>
						<row>
							<label value="Фактический адрес " />
							<textbox id="ao_post_address_fact" width="90%"
								value="@{customermain$composer.current.o_post_address_fact}" />
						</row>
						<row>
							<label
								value="Дата активации использования адреса * " />
							<datebox id="ao_address_fact_date" width="90%"
								value="@{customermain$composer.current.o_address_fact_date}" />
						</row>
						<row>
							<label value="Резидентность *" />
							<rcombobox id="acode_resident" width="90%"
								selecteditem="@{customermain$composer.current.code_resident}" />
						</row>
						<row>
							<label value="Национальность *" />
							<rcombobox id="ap_code_nation" width="90%"
								selecteditem="@{customermain$composer.current.p_code_nation}" />
						</row>
						<row>
							<label value="Код налоговой организации" />
							<rcombobox id="ap_code_tax_org" width="90%"
								selecteditem="@{customermain$composer.current.p_code_tax_org}" />
						</row>
					</rows>
				</grid>
			</hlayout>
            <grid id="acc_add_grid" hflex="1">
				<columns>
						<column width="18%" />
						<column width="28%" />
						<column width="8%" />						
						<column width="18%" />
						<column width="28%" />
				</columns>
				<rows>
						<row>
							<label value="Код балансового счета *" />
							<rcombobox id="acc_bal" width="90%"
								selecteditem="@{customermain$composer.curr_acc.acc_bal}" />
							<cell></cell>
							<label value="Порядковый номер счета *" />
							<textbox id="id_order" width="90%"
								value="@{customermain$composer.curr_acc.id_order}"  />
						</row>
						<row>
							<label value="Счет" />
							<textbox id="tranz_acct" readonly="true" width="90%"
								value="@{customermain$composer.curr_acc.tranz_acct}"  />
                            <cell></cell>
							<label value="Код счетевого продукта *" />
							<rcombobox id="o_product_code1" width="90%"
								selecteditem="@{customermain$composer.curr_acc.productCode1}" />
						</row>
						<row>
							<label value="Комментарий " />
							<textbox id="o_comment_text" width="90%"
								value="@{customermain$composer.curr_acc.commentText}" />
                            <cell></cell>
							<cell></cell>
							<cell></cell>
						</row>						
												
                </rows>
            </grid> 
            <grid id="card_add_grid" hflex="1">
				<columns>
						<column width="18%" />
						<column width="28%" />
						<column width="8%" />						
						<column width="18%" />
						<column width="28%" />
				</columns>
				<rows>
        			<row>
							<label value="Код карточного продукта *" />
							<rcombobox id="o_card_product_code1" width="90%"
								selecteditem="@{customermain$composer.curr_card.productCode1}" />
                            <cell></cell>
							<label value="Комментарий " />
							<textbox id="o_card_comment_text" width="90%"
								value="@{customermain$composer.curr_card.commentText}" />
					</row>
                </rows>
            </grid> 
            						
			<toolbar>
				<toolbarbutton id="add_btn" label="Сохранить"
					image="/images/+.png" />
				<toolbarbutton id="close_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>
	
	<window id="add_account" mode="modal" width="45%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Открытие счета(АБС) и контракта(WAY)" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="90%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row>
							<label value="Код балансового счета *" />
							<rcombobox id="acc_bal" width="90%"
								selecteditem="@{customermain$composer.curr_acc.acc_bal}" />
						</row>
						<row>
							<label value="Порядковый номер счета *" />
							<textbox id="id_order" width="90%"
								value="@{customermain$composer.curr_acc.id_order}"  />
						</row>
							<row>
							<label value="Счет" />
							<textbox id="tranz_acct" readonly="true" width="90%"
								value="@{customermain$composer.curr_acc.tranz_acct}"  />
						</row>
						<row>
							<label value="Код счетевого продукта *" />
							<rcombobox id="o_product_code1" width="90%"
								selecteditem="@{customermain$composer.curr_acc.productCode1}" />
						</row>
						<row>
							<label value="Комментарий к счетовому контракту" />
							<textbox id="o_comment_text" width="90%"
								value="@{customermain$composer.curr_acc.commentText}" />
						</row>

						<row>
							<label value="Код карточного продукта *" />
							<rcombobox id="o_card_product_code1" width="90%"
								selecteditem="@{customermain$composer.curr_card.productCode1}" />
						</row>
						<row>
							<label value="Комментарий к карточному контракту" />
							<textbox id="o_card_comment_text" width="90%"
								value="@{customermain$composer.curr_card.commentText}" />
						</row>
						
						<row>
							<label value="Номер телефона для СМС Инфо по счету и карту" />
							<textbox id="o_postal_code" width="90%"
								value="@{customermain$composer.curr_acc.phone}" />
						</row>
						
					</rows>
				</grid>
				
			</hlayout>

			<toolbar>
				<toolbarbutton id="add_acc_btn" label="Сохранить"
					image="/images/+.png" />
				<toolbarbutton id="close_wnd_acc_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>

    <window id="add_card_wnd" mode="modal" width="55%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Открытие карточного контракта(WAY)" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="100%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>

						<row visible="false">
							<label value="RBS Number" />
							<textbox id="o_rbs_number" readonly="true"
								value="@{customermain$composer.curr_card.rbsNumber}"  />
						</row>
						<row>
							<label value="Код карточного продукта *" />
							<rcombobox id="o_product_code1"
								selecteditem="@{customermain$composer.curr_card.productCode1}" />
						</row>
						<row>
							<label value="Комментарий " />
							<textbox id="o_comment_text"
								value="@{customermain$composer.curr_card.commentText}" />
						</row>
			
					</rows>
				</grid>
				
			</hlayout>

			<toolbar>
				<toolbarbutton id="add_card_btn" label="Сохранить"
					image="/images/+.png" />
				<toolbarbutton id="close_wnd_card_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>

    <window id="lock_card_wnd" mode="modal" width="55%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Блокировка карты" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="100%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row id="row_stop_cause">
							<label value="Причина(вид) блокировки(Stop cause) *" />
							<rcombobox id="rcb_stop_cause" width="80%"/>
						</row>
						<row>
							<label value="Комментарий(описание) блокировки/разблокировки " />
							<textbox id="txt_comment_text" width="80%"/>
						</row>
					</rows>
				</grid>
				
			</hlayout>

			<toolbar>
				<toolbarbutton id="lock_card_btn" label="Блокировать"
					image="/images/-.png" />
				<toolbarbutton id="unlock_card_btn" label="Разблокировать"
					image="/images/+.png" />
				<toolbarbutton id="close_wnd_lock_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>
	

	
	<window id="update_sms_wnd_card" mode="modal" width="55%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Подключение/отключение SMS услугу" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="100%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row id="row_acc">
							<label id="lbl_acc_rbs_number" value="тел.номер для СМС информирования. по счету: *" />
							<textbox id="txt_acc_phone" width="80%"/>
						</row>
						<!-- <row id="row_card">
							<label id="lbl_card_rbs_number" value="тел.номер для СМС информирования. по карту: *" />
							<textbox id="txt_card_phone" width="80%"/>
						</row>  -->
					</rows>
				</grid>
				
			</hlayout>

			<toolbar>
				<toolbarbutton id="sms_on_btn" label="Включить"
					image="/images/+.png" />
				<toolbarbutton id="sms_off_btn" label="Отключить"
					image="/images/-.png" />
				<toolbarbutton id="close_wnd_lock_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>

    <window id="update_sms_wnd_acc" mode="modal" width="55%" closable="true"
		onClose="self.visible = false; event.stopPropagation();"
		title="Подключение/отключение SMS услугу" position="center,center"
		visible="false">

		<vlayout hflex="1">
			<hlayout id="addgrd" width="100%">
				<grid id="addgrdl" hflex="1">
					<columns>
						<column width="40%" />
						<column width="60%" />
					</columns>
					<rows>
						<row id="row_acc">
							<label id="lbl_acc_rbs_number" value="тел.номер для СМС информирования. по счету: *" />
							<textbox id="txt_acc_phone" width="80%"/>
						</row>
					</rows>
				</grid>
				
			</hlayout>

			<toolbar>
				<toolbarbutton id="sms_on_btn" label="Включить"
					image="/images/+.png" />
				<toolbarbutton id="sms_off_btn" label="Отключить"
					image="/images/-.png" />
				<toolbarbutton id="close_wnd_lock_btn" label="Закрыть"
					image="/images/stop.png" />
				<label value=" * - поля обязательны к заполнению"></label>
			</toolbar>
		</vlayout>
	</window>
	
	<window id="showBalanceWindow" width="600px" mode="modal"
		visible="false" closable="true" title="Balance"
		position="center, center"
		onClose="self.visible  =  false; event.stopPropagation();">

		<grid id="showBalanceGrid">
			<columns>
				<column hflex="1"></column>
				<column hflex="2"></column>
				<column hflex="1"></column>
				<column hflex="2"></column>
			</columns>
			<rows>
				<row>
					<label value="Имя " />
					<textbox readonly="true" width="100%" value="Значение"></textbox>
					<label value="Имя " />
					<textbox readonly="true" width="100%" value="Значение"></textbox>
				</row>
			</rows>
		</grid>

		<toolbar>
			<toolbarbutton id="showBalanceCloseBtn"
				label="Закрыть" />
		</toolbar>

	</window>


</window>
