<?component name="rcombobox" extends="combobox" class="com.is.utils.RefCBox"?>
<zk>
	<style>
		.customIcon{
		width: 100%;
		height: 25px;
		text-align: center;
		background: -webkit-linear-gradient(-90deg, rgba(52,133,209,1) 0,
		rgba(55,141,211,0.5) 24%, rgba(47,125,188,0.2) 50%,
		rgba(55,141,211,0.5) 79%, rgba(52,133,209,1) 100%);
		background: -moz-linear-gradient(180deg, rgba(52,133,209,1) 0,
		rgba(55,141,211,0.5) 24%, rgba(47,125,188,0.2) 50%,
		rgba(55,141,211,0.5) 79%, rgba(52,133,209,1) 100%);
		background: linear-gradient(180deg, rgba(52,133,209,1) 0, rgba(55,141,211,0.5)
		24%, rgba(47,125,188,0.2) 50%, rgba(55,141,211,0.5) 79%,
		rgba(52,133,209,1) 100%);
		background-repeat: repeat;
		}
		.z-fieldset legend {
		font-size: 20px;
		font-weight: 900;
		font-style: oblique;
		}
		.add_guarr{
		font-size: 16px;
		font-weight: 900;
		font-style: oblique;
		background: orange;
		border:6px inset #ffffff;
		box-shadow:3px 3px 1px #7a1848;
		-moz-box-shadow:3px 3px 1px #7a1848;
		-webkit-box-shadow:3px 3px 1px #7a1848;
		border-radius:15px 15px 15px 15px;
		-moz-border-radius:15px 15px 15px 15px;
		-webkit-border-radius:15px 15px 15px 15px;
		width:160px;
		}
		.add_guarr:active{
		font-size: 16px;
		font-weight: 900;
		font-style: oblique;
		color:black;
		background: red;
		border:6px inset #ffffff;
		box-shadow:3px 3px 1px #7a1848;
		-moz-box-shadow:3px 3px 1px #7a1848;
		-webkit-box-shadow:3px 3px 1px #7a1848;
		border-radius:15px 15px 15px 15px;
		-moz-border-radius:15px 15px 15px 15px;
		-webkit-border-radius:15px 15px 15px 15px;
		width:160px;
		}
	</style>
	<div apply="com.is.creditanket.CreditViewCtrl">
		<toolbar>
			<toolbarbutton id="btn_back" label="${labels.back}"
				image="/images/file.png" />
			<toolbarbutton id="btn_search" label="${labels.search}"
				image="/images/search.png" />
			<toolbarbutton id="btn_add" label="${labels.add}"
				image="/images/+.png" />
		</toolbar>
		<div id="grid">
			<paging id="creditPaging" />
			<listbox id="dataGrid">
				<listhead>
					<listheader label="Филиал" />
					<listheader label="№ Анкеты" />
					<listheader label="Рег. № Заявки" />
					<listheader label="Дата ввода" />
					<listheader label="Клиент" />
					<listheader label="Наименование" />
					<listheader label="Валюта Заявки" />
					<listheader label="Сумма заявки" />
					<listheader label="Состояние" />
					<listheader label="Статус" />
					<listheader label="Состояние НИКИ" />
					<listheader id="action_lh" label="Действие" />
				</listhead>
			</listbox>
		</div>
		<div id="addgrd" visible="false">
			<groupbox open="false">
				<caption sclass="customIcon" label="Сведения о заемщике" />
				<grid>
					<rows>
						<row>
							<label value="МФО банка" />
							<rcombobox id="branch" width="100%" />
							<label value="Регистрационный № заявки" />
							<longbox id="niki_id" width="100%" maxlength="10" />
						</row>
						<row>
							<label value="Наименование субзаемщика" />
							<textbox id="sub_name" width="100%" maxlength="80" />
							<label value="Адрес субзаемщика" />
							<textbox id="sub_addr" width="100%" maxlength="80" />
						</row>
						<row>
							<label value="Численность сотрудников" />
							<intbox id="emp_count" width="100%" maxlength="6" />
						</row>
						<row>
							<label value="Является ли заемщик владельцем акций банка" />
							<rcombobox id="is_sec" width="100%" />
							<label value="Состояние учета на предприятии" />
							<rcombobox id="acc_state" width="100%" />
						</row>
						<row>
							<label value="Имеется задолженность по другим ссудам" />
							<rcombobox id="is_ld" width="100%" />
							<label value="Заемщик является строительной организацией" />
							<rcombobox id="is_building" width="100%" />
						</row>
					</rows>
				</grid>
			</groupbox>
			<groupbox open="false">
				<caption sclass="customIcon" label="Общая характеристика кредита" />
				<grid>
					<rows>
						<row>
							<label value="Номер заявки клиента" />
							<textbox id="eq_num" width="100%" maxlength="20" />
							<label value="Дата заявки" />
							<datebox id="eq_date" width="100%" format="dd.MM.yyyy"
								maxlength="10" />
						</row>
						<row>
							<label value="Валюта заявки" />
							<rcombobox id="currency" width="100%" />
							<label value="Сумма" />
							<doublebox id="amount" width="100%" format="#0.00"
								maxlength="22" />
						</row>
						<row>
							<label value="Номер Постановления ааб.Мина" />
							<textbox id="p_num" width="100%" maxlength="20" />
							<label value="Дата постановления" />
							<datebox id="p_date" width="100%" format="dd.MM.yyyy"
								maxlength="10" />
						</row>
						<row>
							<label value="Номер протокола Кредитного коммитета" />
							<textbox id="crc_num" width="100%" maxlength="20" />
							<label value="Дата протокола" />
							<datebox id="crc_date" width="100%" maxlength="10"
								format="dd.MM.yyyy" />
						</row>
						<row>
							<label value="ТЭО выдано (кем)" />
							<textbox id="t_author" width="100%" maxlength="80" />
							<label value="Дата подписания" />
							<datebox id="t_date" width="100%" maxlength="10" format="dd.MM.yyyy" />
						</row>
						<row>
							<label value="Характер ответа" />
							<rcombobox id="t_type" width="100%" />
							<label value="Статус ссуды" />
							<rcombobox id="status" width="100%" />
						</row>
						<row>
							<label value="Номер кредитного договора" />
							<textbox id="ld_num" width="100%" maxlength="20" />
							<label value="Дата кредитного договора" />
							<datebox id="ld_date" width="100%" maxlength="10" format="dd.MM.yyyy" />
						</row>
						<row>
							<label value="Дата закрытия кредитного договора" />
							<datebox id="date_close" width="100%" maxlength="10"
								format="dd.MM.yyyy" />
							<label value="Сумма договора" />
							<decimalbox id="ld_amount" width="100%" maxlength="22"
								format="#0.00" />
						</row>
						<row>
							<label value="Номер кредитной линии" />
							<intbox id="cl_num" width="100%" maxlength="4" />
							<label value="Метод начисления" />
							<rcombobox id="calc_id" width="100%" />
						</row>
						<row>
							<label value="Кредит финансирует инвестиционный проект" />
							<rcombobox id="is_inv" width="100%" />
							<label value="Валюта проекта" />
							<rcombobox id="currency_inv" width="100%" />
						</row>
						<row>
							<label value="Сумма проекта" />
							<doublebox id="amount_inv" width="100%" maxlength="22"
								format="#0.00" />
							<label value="Целевое назначение кредита" />
							<textbox id="target" width="100%" maxlength="200" />
						</row>
						<row>
							<label value="Шифр целевого назначения кредита" />
							<rcombobox id="shifr_id" width="100%" />
							<label value="Шифр источника финансирования" />
							<rcombobox id="sred_id" width="100%" />
						</row>
						<row>
							<label value="Срочность" />
							<rcombobox id="term_type" width="100%" />
							<label value="Номер срочного обязательства" />
							<textbox id="al_num" width="100%" maxlength="20" />
						</row>
						<row>
							<label value="Основной вид деятельности" />
							<textbox id="prod_name" width="100%" maxlength="200" />
							<label value="Тип кредита" />
							<rcombobox id="type_id" width="100%" />
						</row>
						<row>
							<label value="Шифр кредитования" />
							<rcombobox id="kred_id" width="100%" />
							<label value="Шифр кредитования ЦБ" />
							<rcombobox id="kred_id_cb" width="100%" />
						</row>
						<row>
							<label value="Тип заемщика" />
							<rcombobox id="use_branch" width="100%" />
							<label value="Класс кредитоспособности" />
							<rcombobox id="klass_id" width="100%" />
						</row>
						<row>
							<label value="Класс качества" />
							<rcombobox id="klassp_id" width="100%" />
							<label value="Фонд льготного кредитования" />
							<rcombobox id="is_tax" width="100%" />
						</row>
						<row>
							<label value="Требует акцепт платеж" />
							<rcombobox id="acceptance" width="100%" />
							<label value="Начисление резерва от" />
							<rcombobox id="cres" width="100%" />
						</row>
						<row id="commision_row" visible="false">
							<label value="Дата начала взимания комиссии за обязательство" />
							<datebox id="date_fee" width="100%" maxlength="10"
								format="dd.MM.yyyy" />
							<label value="Дата закрытие кредитной линии" />
							<datebox id="date_end" width="100%" maxlength="10"
								format="dd.MM.yyyy" />
						</row>
					</rows>
				</grid>
			</groupbox>
			<groupbox open="false">
				<caption sclass="customIcon" label="Обеспечение кредита и источники погашения" />
				<div id="guars" />
				<grid>
					<rows>
						<row align="center">
							<button id="add_guarr" label="Добавить обеспечение" />
						</row>
					</rows>
				</grid>
			</groupbox>
			<groupbox open="false">
				<caption sclass="customIcon" label="История ставок" />
				<hbox width="100%" widths="50%,50%">
					<vbox>
						<radiogroup orient="vertical">
							<grid>
								<columns>
									<column label="Вид ставки" width="80%" />
									<column width="20%" />
								</columns>
								<rows>
									<row>
										<vbox id="ld_exp_radio" />
										<vbox id="ld_exp_radio_btn" />
									</row>
									<row>
										<cell colspan="2">
											<button id="btn_add_exp" label="Добавить описание ставки"
												width="100%" />
										</cell>
									</row>
								</rows>
							</grid>
						</radiogroup>
					</vbox>
					<vbox>
						<grid>
							<columns>
								<column label="Описание ставки" />
								<column />
							</columns>
							<rows>
								<row>
									<label value="Тип ставки" />
									<rcombobox width="100%" id="rate_type" readonly="true"
										buttonVisible="false" />
								</row>
								<row>
									<label value="Метод расчета" />
									<rcombobox width="100%" id="rate_method" readonly="true"
										buttonVisible="false" />
								</row>
								<row>
									<label value="Метод платежа" />
									<rcombobox width="100%" id="pay_method" readonly="true"
										buttonVisible="false" />
								</row>
							</rows>
						</grid>
					</vbox>
				</hbox>
				<grid>
					<columns>
						<column label="Наименование ставки" />
						<column label="Процент" />
						<column label="Коеффициент" />
						<column label="Дата начала действия" />
						<column label="Дата окончания действия" />
						<column id="btn_save_rate" visible="false" />
						<column id="btn_del_rate" visible="false" />
					</columns>
					<rows id="rate_row" />
				</grid>
				<grid>
					<rows>
						<row>
							<button id="btn_add_rate" width="100%" label="Добавить ставку"
								visible="false" />
						</row>
					</rows>
				</grid>
			</groupbox>
			<groupbox open="false">
				<caption sclass="customIcon" label="Графики" />
				<hbox width="100%" widths="50%,50%">
					<vbox>
						<radiogroup id="main_radio">
							<vbox id="ld_gr_radio">
								<grid>
									<columns>
										<column label="Вид граффика" />
									</columns>
								</grid>
							</vbox>
							<grid>
								<rows>
									<row>
										<button id="fill_graf" width="100%" label="Заполнить" />
										<button id="recall_graf" width="100%" label="Расчитать" />
									</row>
								</rows>
							</grid>
						</radiogroup>
					</vbox>
					<vbox>
						<grid mold="paging" pageSize="12">
							<columns>
								<column label="Дата выплаты/погашения" />
								<column label="Сумма выплаты/погашения" />
								<column label="Номер освоения" />
							</columns>
							<rows id="graf_rows" />
						</grid>
					</vbox>
				</hbox>
				<grid>
					<columns>
						<column label="Метод формирования графика" />
						<column label="Дата начала и завершения расчета" />
						<column visible="false" id="period_column" label="Переодичность выплат" />
						<column visible="false" id="day_column" label="День выплаты" />
						<column label="Общая сумма договора" />
						<column label="Общая сумма графика" />
					</columns>
					<rows>
						<row>
							<rcombobox id="graf_method" readonly="true"
								buttonVisible="false" />
							<cell colspan="1">
								<datebox id="date_from" readonly="true" buttonVisible="false"
									format="dd.MM.yyyy" />
								<datebox id="date_to" readonly="true" buttonVisible="false"
									format="dd.MM.yyyy" />
							</cell>
							<cell visible="false" id="period_cell" colspan="1">
								<intbox width="15%" id="num" maxlength="2" readonly="true" />
								<label value=" раз в " />
								<rcombobox width="45%" id="pay_period" readonly="true"
									buttonVisible="false" />
							</cell>
							<intbox visible="false" id="day" maxlength="2" readonly="true" />
							<label id="ld_amount_gr" />
							<label id="ld_graff_amount" />
						</row>
					</rows>
				</grid>
			</groupbox>
			<groupbox open="false">
				<caption sclass="customIcon" label="Счета" />
				<grid mold="paging" pageSize="10">
					<columns>
						<column label="№" />
						<column label="Наименование типа счета" />
						<column label="Балансовый счет" />
						<column label="Счет" />
						<column label="Состояние счета" />
						<column label="Текущее сальдо счета" />
						<column label="Прогнозное сальдо" />
						<column label="№ типа счета" />
					</columns>
					<rows id="acc_rows" />
				</grid>
			</groupbox>
			<toolbar>
				<toolbarbutton id="btn_confirm" label="Утверждение"
					visible="false" />
				<toolbarbutton id="btn_close" label="Закрытие"
					visible="false" />
				<toolbarbutton id="btn_save" label="Сохранить" />
				<toolbarbutton id="btn_cancel" label="Отмена" />
			</toolbar>
		</div>
	</div>
</zk>