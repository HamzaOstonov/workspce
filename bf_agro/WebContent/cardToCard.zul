<?component name="rcombobox" extends="combobox" class="com.is.utils.RefCBox"?>
<window id="cardmain" width="100%" height="100%" border="normal"
	apply="com.is.card_to_card.CardtcViewCtrl">
	<tabbox id="mainTabbox">
		<tabs>
			<tab label="Форма переброска остаток карты" id="mainTab" />
			<tab label="Протокол" id="protocolTab" />
		</tabs>
		<tabpanels>
			<tabpanel>
				<hlayout sclass="z-valign-top" style="overflow:auto;">
					<vlayout id="grd1" hflex="1">
						<grid>
							<columns>
								<column width="40%" />
								<column width="60%" />
							</columns>
							<rows>
								<row>
									<label
										value="Тип продукта(карты) - Отправитель" />
									<rcombobox id="rcb_card_from"
										selecteditem="@{customermain$composer.current.o_client_type}" />
								</row>
							</rows>
						</grid>
						<label value="Фильтр:" />
						<grid>
							<columns>
								<column width="40%" />
								<column width="60%" />
							</columns>
							<rows>
								<row>
									<label value="Клиент" />
									<textbox id="txbId_client"
										value="@{customermain$composer.filter.id_client}"
										forward="onOK=onOkToFilter" />
								</row>
								<row>
									<label value="Карта" />
									<textbox id="txbCard"
										value="@{customermain$composer.filter.p_pinfl}"
										forward="onOK=onOkToFilter" />
								</row>
								<row>
									<label value="Наименование" />
									<textbox id="txbName"
										value="@{customermain$composer.filter.p_pinfl}"
										forward="onOK=onOkToFilter" />
								</row>
								<row visible="false">
									<label value="ПИНФЛ(не работает)" />
									<textbox id="txbPinfl"
										value="@{customermain$composer.filter.p_pinfl}"
										forward="onOK=onOkToFilter" />
								</row>
							</rows>
						</grid>
						<toolbar visible="true" orient="vertical">
							<toolbarbutton id="tbtn_search"
								label="Поиск" image="/images/search.png" />
							<toolbarbutton id="btn_utv"
								label="${labels.openway.comm}" visible="false"
								image="/images/stop.png" />
						</toolbar>
						<listbox id="dataGrid"
							style="border::normal;height:300px;" multiple="true" width="100%"
							selectedItem="@{card_to_cardmain$composer.currentfrom}">
							<listhead sizable="true">
								<listheader label="Филиал" width="10%" />
								<listheader label="Карта" width="18%"
									id="nnmb_h1" />
								<listheader label="Клиент" width="10%" />
								<listheader label="Счет" width="20%" />
								<listheader label="Наименование"
									width="35%" />
								<listheader label="Срок" width="27%" />
								<listheader label="Статус" width="15%" />
							</listhead>
						</listbox>
						<toolbar visible="true" orient="vertical">
							<toolbarbutton id="tbtn_settings" visible="false"
								label="Просмотр параметры" image="/images/config.png" />
							<toolbarbutton id="tbtn_move_saldo"
								label="Переброска остаток" image="/images/send.png" />
						</toolbar>
					</vlayout>
					<vlayout id="grd2" hflex="1">
						<grid>
							<columns>
								<column width="40%" />
								<column width="60%" />
							</columns>
							<rows>
								<row>
									<label
										value="Тип продукта(карты) - Получатель" />
									<rcombobox id="rcb_card_to"
										selecteditem="@{card_to_cardmain$composer.currentto}" />
								</row>
							</rows>
						</grid>
						<listbox style="border:none" id="dataGrid2"
							multiple="true" width="100%"
							selectedItem="@{card_to_cardmain$composer.currentto}">
							<listhead sizable="true">
								<listheader label="Филиал" width="10%" />
								<listheader label="Карта" width="18%"
									id="nnmb_h2" />
								<listheader label="Клиент" width="10%" />
								<listheader label="Счет" width="20%" />
								<listheader label="Наименование"
									width="35%" />
								<listheader label="Срок" width="27%" />
								<listheader label="Статус" width="15%" />
							</listhead>
						</listbox>
					</vlayout>
				</hlayout>
			</tabpanel>
			<tabpanel>
				<div
					style="height: 600px; overflow-y: auto; overflow-x: auto; white-space: nowrap; width: 100%; min-width: 1200px;">
					<paging id="protocolPaging" pageSize="10" />
					<listbox id="dataGrid3" mold="paging"
						style="border: none; text-align: center; min-width: 1200px;"
						hflex="min" vflex="1" multiple="true" width="100%"
						selectedItem="@{card_to_cardmain$composer.current0}">

						<listhead sizable="true">
							<listheader label="ID" />
							<listheader label="BRANCH" />
							<listheader label="bank_date" />
							<listheader label="date_TIME" />
							<listheader label="FROMCARDTYPE" />
							<listheader label="FROMCARDNUMBER" />
							<listheader label="FROMCARDBRANCH" />
							<listheader label="FROMCARDacc" />
							<listheader label="FROMCARD_client_id" />
							<listheader label="FROMCARD_client_name" />
							<listheader label="TOCARDTYPE" />
							<listheader label="TOCARDNUMBER" />
							<listheader label="TOCARDBRANCH" />
							<listheader label="TOCARDacc" />
							<listheader label="TOCARD_client_id" />
							<listheader label="TOCARD_client_name" />
							<listheader label="STATE" />
						</listhead>

					</listbox>

				</div>

				<window mode="overlapped" id="initialGrid1"
					visible="false" width="80%"
					style="position: absolute; top: 50%; left: 50%; 
			  		transform: translate(-50%, -50%); background-color: rgba(255, 255, 255, 0.9); 
           			box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);"
					closable="true" height="auto" border="normal">
					<label id="name" value="selectedItem" />
					<listbox id="dataGrid4" style="border:none;"
						multiple="true" visible="true"
						selectedItem="@{card_to_cardmain$composer.current1}">
						<listhead sizable="true">
							<listheader label="ID" />
							<listheader label="PROTOCOL_ID" />
							<listheader label="date_TIME" />
							<listheader label="CODE" />
							<listheader label="description" />
						</listhead>
					</listbox>
					<separator height="20px" />
					<label id="general_name" visible="false"
						value="GENERAL TABLE" />
					<listbox id="dataGrid5" visible="false"
						style="border:none;" multiple="true"
						selectedItem="@{card_to_cardmain$composer.current1}">
						<listhead sizable="true">
							<listheader label="ID" />
							<listheader label="ACC_CL" />
							<listheader label="BANK_CL" />
							<listheader label="NAME_CL" />
							<listheader label="ACC_CO" />
							<listheader label="BANK_CO" />
							<listheader label="NAME_CO" />
							<listheader label="SUMMA" />
							<listheader label="PURPOSE" />
						</listhead>
					</listbox>
					<toolbar>
						<toolbarbutton id="btn_hide" label="Hide"
							visible="true" />
						<toolbarbutton id="btn_exit" label="Exit"
							visible="true" />
					</toolbar>
				</window>

				<window mode="overlapped" id="initialGrid1_more"
					visible="false" width="40%"
					style="position: absolute; top: 50%; left: 50%; 
              transform: translate(-50%, -50%); background-color: rgba(255, 255, 255, 0.9); 
              box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);"
					closable="true" height="auto" border="normal">
					<label id="namemore" value="DESCRIPTION"/>
					<textbox id="apimore" />
					<toolbar>
						<toolbarbutton id="btn_exit1" label="Exit"
							visible="true" />
					</toolbar>
				</window>
			</tabpanel>
		</tabpanels>
	</tabbox>
</window>